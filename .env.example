# Copy to .env (git-ignored) and fill in. Only GOOGLE_API_KEY is required for Gemini mode.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# Resource limits (defaults sized for Ryzen 5 4600G 6C/12T, 16 GB)
SERVER_CPUS=2
SERVER_MEM=1g
DASH_CPUS=4
DASH_MEM=2g
PG_CPUS=2
PG_MEM=2g

# Python process model: py-Nw (workers = SERVER_CPUS) by default; set 1 for the py-1w profile
PY_WORKERS=2
DB_POOL_MAX=10

# Mock LLM / embedder
MOCK_FIRST_TOKEN_DELAY_MS=250
MOCK_TOKEN_DELAY_MS=15
MOCK_TOKENS=60
MOCK_EMBED_DELAY_MS=40
EMBED_BATCH_SIZE=100

# Postgres credentials (local only)
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench

# Host ports (127.0.0.1 only). Postgres defaults to 5433 so it doesn't clash
# with a PostgreSQL already installed on the host (common on Ubuntu).
PG_HOST_PORT=5433
GO_HOST_PORT=8081
PY_HOST_PORT=8082
DASH_HOST_PORT=3000
