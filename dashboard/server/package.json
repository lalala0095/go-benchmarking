{
  "name": "bench-dashboard-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "stub": "tsx ../dev/stub-target.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@kubernetes/client-node": "1.4.0",
    "dockerode": "4.0.12",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "undici": "7.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.47",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
